# Copy this file to server/.env and fill in real values. Never commit server/.env.

PORT=5000
NODE_ENV=development

# Frontend origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGIN=http://localhost:5173,https://your-site.vercel.app

# SMTP — Gmail example. SMTP_PASS must be a Gmail *App Password*, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact form messages are delivered.
MAIL_TO=gopig6581@gmail.com
MAIL_FROM_NAME=Portfolio Contact Form
